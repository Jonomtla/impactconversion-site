# Resend — https://resend.com/api-keys
# Create an account, verify impactconversion.com as a sending domain, generate an API key
RESEND_API_KEY=re_your_key_here

# Email the contract submissions get sent to
RESEND_TO_EMAIL=jono@impactconversion.com

# The "from" address — must be on a domain verified in Resend
# Until impactconversion.com is verified, Resend allows onboarding@resend.dev for testing
RESEND_FROM_EMAIL=contracts@impactconversion.com

# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile → Add site
# Protects the /contact form. Use widget mode "Managed" so most visitors see
# nothing. Add impactconversion.com (and localhost for dev) as hostnames.
# If these are unset the form still works and verification is skipped, with the
# honeypot carrying the load — so set them in Vercel for production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x_your_site_key_here
TURNSTILE_SECRET_KEY=0x_your_secret_key_here
